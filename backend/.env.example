# Anthropic（Claude）APIキー。https://console.anthropic.com で発行する。
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx

# 使うモデル（任意。既定は claude-haiku-4-5）。
# 決意の判定など精度を上げたいなら claude-sonnet-5 にする。
MODEL=claude-haiku-4-5

# ポート（任意。多くのホスティングは自動で割り当てる）。
PORT=3000

# アプリ・サーバー間の共有シークレット（任意だが設定を推奨）。
# 設定すると、リクエストヘッダー X-App-Secret が一致しない限り /analyze を拒否する。
# アプリ側は --dart-define=APP_SHARED_SECRET=... で同じ値を焼き込む。
# 注意: APKを解析すれば抜き出せるため、Play Integrity/App Checkの代替にはならない
# （無認証よりはマシ、という暫定策）。
APP_SHARED_SECRET=
